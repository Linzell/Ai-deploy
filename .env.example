# ============================================================================
# MAIIA AI Inference Service - Environment Configuration
# ============================================================================
# Copy this file to .env and customize for your deployment
#
# Default features include: candle, llama, http, grpc
# Build with: cargo build --release
# Minimal build: cargo build --release --no-default-features --features http
#
# All config vars use MAIIA_AI_ prefix (except standard vars like HF_TOKEN, AWS_*)
# You can also use TOML config files - set MAIIA_AI_CONFIG_PATH to the file path
#
# Example usage:
#   MAIIA_AI_CONFIG_PATH=./configs/echo.toml ./target/release/inference-service
#   MAIIA_AI_TASK_TYPE=echo MAIIA_AI_GRPC_PORT=50051 ./target/release/inference-service

# ============================================================================
# Config File (optional)
# ============================================================================
# Path to TOML config file - if set, loads from file first, then ENV overrides
# MAIIA_AI_CONFIG_PATH=./configs/chat-hf.toml

# ============================================================================
# Task Configuration
# ============================================================================
# Task types by backend:
#   ONNX:      feature-extraction, text-classification, token-classification,
#              question-answering, summarization, translation, fill-mask,
#              automatic-speech-recognition, image-classification, object-detection,
#              image-to-text, seq2seq (Florence-2), echo
#   Candle:    text-generation (Qwen3, Llama 3.x, Mistral)
#   llama.cpp: text-generation-gguf (any GGUF model)
# MAIIA_AI_TASK_TYPE=echo

# Custom task name (defaults to "maiia.<task_type>.v1")
# MAIIA_AI_TASK_NAME=maiia.chat.v1

# ============================================================================
# Model Configuration
# ============================================================================
# Model source: huggingface, s3, local
# MAIIA_AI_MODEL_SOURCE=local

# Model path:
#   - HuggingFace: model ID (e.g., "openai/whisper-large-v3", "Qwen/Qwen3-0.6B")
#   - S3: prefix in bucket (e.g., "models/gpt-oss-20b")
#   - Local: filesystem path (e.g., "/models/my-model")
# MAIIA_AI_MODEL_PATH=openai/whisper-large-v3

# Model revision for HuggingFace (branch, tag, or commit)
# MAIIA_AI_MODEL_REVISION=main

# ONNX file name within the model directory (for ONNX backend)
# MAIIA_AI_ONNX_FILE=model.onnx

# GGUF file name within the model directory (for llama.cpp backend)
# MAIIA_AI_GGUF_FILE=model.gguf

# ============================================================================
# Backend Selection
# ============================================================================
# Backend: auto (default), onnx, candle, llama
# Note: Backend must be enabled at compile time with --features flag
# MAIIA_AI_BACKEND=auto

# ============================================================================
# Inference Configuration
# ============================================================================
# Device: auto (default), cpu, gpu, cuda, metal
# Note: metal requires macOS, cuda requires NVIDIA GPU
# GPU auto-configuration (llama.cpp): n_gpu_layers=99, flash attention, Q8_0 KV cache
# MAIIA_AI_DEVICE=auto

# Max tokens for generation (text-generation tasks)
MAIIA_AI_MAX_TOKENS=2048

# Temperature for generation (0.0 = deterministic, 1.0+ = creative)
MAIIA_AI_TEMPERATURE=0.7

# Top-p (nucleus) sampling threshold
MAIIA_AI_TOP_P=0.9

# Top-k sampling (0 = disabled)
# MAIIA_AI_TOP_K=50

# Repetition penalty (1.0 = no penalty)
# MAIIA_AI_REPETITION_PENALTY=1.1

# Number of threads for CPU inference
# MAIIA_AI_NUM_THREADS=4

# ============================================================================
# HuggingFace Configuration
# ============================================================================
# API token for gated models (Llama, Mistral, etc.)
# Get your token at: https://huggingface.co/settings/tokens
# Can also use standard HF_TOKEN env var
# IMPORTANT: Do NOT commit real tokens to version control.
# Set this via your deployment's secret manager or local .env file only.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cache directory for HuggingFace downloads
# MAIIA_AI_HF_CACHE_DIR=/var/cache/huggingface

# ============================================================================
# S3/MinIO Configuration
# ============================================================================
# S3 bucket name
# MAIIA_AI_S3_BUCKET=maiia-models

# S3 prefix for model files
# MAIIA_AI_S3_MODEL_PREFIX=models

# S3 prefix for data files
# MAIIA_AI_S3_DATA_PREFIX=data

# AWS region (also supports standard AWS_REGION)
# MAIIA_AI_S3_REGION=us-east-1
# AWS_REGION=us-east-1

# Custom endpoint for MinIO or S3-compatible storage
# MAIIA_AI_S3_ENDPOINT=http://minio:9000

# Standard AWS credentials (used automatically)
# IMPORTANT: Do NOT commit real credentials to version control.
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# ============================================================================
# Server Configuration
# ============================================================================
# gRPC server port
MAIIA_AI_GRPC_PORT=50051

# HTTP server port (OpenAI-compatible API)
# MAIIA_AI_HTTP_PORT=8080

# Health check port (for Kubernetes probes)
MAIIA_AI_HEALTH_PORT=8080

# Service name for registration/logging
MAIIA_AI_SERVICE_NAME=maiia-ai-worker

# Enable request batching
MAIIA_AI_ENABLE_BATCHING=true

# Maximum batch size
MAIIA_AI_MAX_BATCH_SIZE=32

# Batch timeout in milliseconds
MAIIA_AI_BATCH_TIMEOUT_MS=100

# Directory for caching downloaded files
MAIIA_AI_CACHE_DIR=/tmp/inference-cache

# Enable caching
MAIIA_AI_ENABLE_CACHE=true

# ============================================================================
# Security
# ============================================================================
# Admin token for authenticated endpoints (e.g., POST /shutdown)
# If not set, the /shutdown endpoint is disabled.
# MAIIA_AI_ADMIN_TOKEN=your-secret-admin-token

# CORS allowed origins (comma-separated)
# If not set, CORS is disabled (no Access-Control-Allow-Origin header).
# MAIIA_AI_CORS_ORIGINS=http://localhost:3000,https://app.example.com

# Maximum HTTP request body size in bytes (default: 10485760 = 10 MB)
# MAIIA_AI_MAX_PAYLOAD_SIZE=10485760

# ============================================================================
# Docker Build (for docker-compose)
# ============================================================================
# Default features include: candle, llama, http, grpc
# Override to build with specific features only:
# FEATURES=candle          # Enable Candle backend only
# FEATURES=llama           # Enable llama.cpp backend only
# FEATURES=candle,llama    # Enable all backends

# ============================================================================
# Observability (OpenTelemetry)
# ============================================================================
# Set OTEL_ENABLED=true and OTEL_ENDPOINT to enable metrics and traces
# via OTLP/gRPC. Both must be set — disabled by default (zero overhead).
#
# Emitted metrics:
#   inference.requests   - Total inference requests (counter)
#   inference.duration   - Request duration in ms (histogram)
#   inference.errors     - Failed inference requests (counter)
#   inference.batch_size - Batch size per dispatch (histogram)
#
# Resource attributes (attached to all metrics/traces):
#   service.name, task.type, task.name, backend, device, model.path
#
# Example: push to an OTel Collector on a Raspberry Pi
OTEL_ENABLED=false
OTEL_ENDPOINT=http://192.168.1.3:4317

# ============================================================================
# Logging
# ============================================================================
# The service has built-in per-crate log levels for clean output:
#   inference_service, inference_core = INFO (startup, config)
#   All other crates = WARN (backend, telemetry, third-party)
#
# To override, uncomment and set RUST_LOG:
# RUST_LOG=info                                              # Everything at INFO (verbose)
# RUST_LOG=inference_service=info                            # Service only
# RUST_LOG=inference_llama=info,inference_onnx=info          # Debug specific backends
# RUST_LOG=debug                                             # Everything at DEBUG (very verbose)
#
# IMPORTANT: Setting RUST_LOG=info overrides ALL per-crate defaults and
# produces verbose output. Only set it if you need full logging.
