# ============================================================================
# MAIIA AI Inference Service - Environment Configuration
# ============================================================================
# Copy this file to .env and customize for your deployment
#
# All config vars use MAIIA_AI_ prefix (except standard vars like HF_TOKEN, AWS_*)
# You can also use TOML config files - set MAIIA_AI_CONFIG_PATH to the file path
#
# Example usage:
#   MAIIA_AI_CONFIG_PATH=./configs/echo.toml ./target/release/inference-service
#   MAIIA_AI_TASK_TYPE=echo MAIIA_AI_GRPC_PORT=50051 ./target/release/inference-service

# ============================================================================
# Config File (optional)
# ============================================================================
# Path to TOML config file - if set, loads from file first, then ENV overrides
# MAIIA_AI_CONFIG_PATH=./configs/chat-hf.toml

# ============================================================================
# Task Configuration
# ============================================================================
# Task type: asr, ocr, chat, embed, echo
MAIIA_AI_TASK_TYPE=echo

# Custom task name (defaults to "maiia.<task_type>.v1")
# MAIIA_AI_TASK_NAME=maiia.chat.v1

# ============================================================================
# Model Configuration
# ============================================================================
# Model source: huggingface, s3, local
MAIIA_AI_MODEL_SOURCE=local

# Model path:
#   - HuggingFace: model ID (e.g., "openai/whisper-large-v3")
#   - S3: prefix in bucket (e.g., "models/gpt-oss-20b")
#   - Local: filesystem path (e.g., "/models/my-model")
# MAIIA_AI_MODEL_PATH=openai/whisper-large-v3

# Model revision for HuggingFace (branch, tag, or commit)
# MAIIA_AI_MODEL_REVISION=main

# ONNX file name within the model directory
# MAIIA_AI_ONNX_FILE=model.onnx

# ============================================================================
# Inference Configuration
# ============================================================================
# Device: cpu, cuda, metal
MAIIA_AI_DEVICE=cpu

# Max tokens for generation (chat/LLM)
MAIIA_AI_MAX_TOKENS=2048

# Temperature for generation
MAIIA_AI_TEMPERATURE=0.7

# Top-p sampling
MAIIA_AI_TOP_P=0.9

# Number of threads for CPU inference
MAIIA_AI_NUM_THREADS=4

# ============================================================================
# HuggingFace Configuration
# ============================================================================
# API token for gated models (Llama, Mistral, etc.)
# Get your token at: https://huggingface.co/settings/tokens
# Can also use standard HF_TOKEN env var
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx

# Cache directory for HuggingFace downloads
# MAIIA_AI_HF_CACHE_DIR=/var/cache/huggingface

# ============================================================================
# S3/MinIO Configuration
# ============================================================================
# S3 bucket name
# MAIIA_AI_S3_BUCKET=maiia-models

# S3 prefix for model files
# MAIIA_AI_S3_MODEL_PREFIX=models

# S3 prefix for data files
# MAIIA_AI_S3_DATA_PREFIX=data

# AWS region (also supports standard AWS_REGION)
# MAIIA_AI_S3_REGION=us-east-1
# AWS_REGION=us-east-1

# Custom endpoint for MinIO or S3-compatible storage
# MAIIA_AI_S3_ENDPOINT=http://minio:9000

# Standard AWS credentials (used automatically)
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# ============================================================================
# Service Configuration
# ============================================================================
# gRPC server port
MAIIA_AI_GRPC_PORT=50051

# Health check port (for Kubernetes probes)
MAIIA_AI_HEALTH_PORT=8080

# Service name for registration/logging
MAIIA_AI_SERVICE_NAME=maiia-ai-worker

# Enable request batching
MAIIA_AI_ENABLE_BATCHING=true

# Maximum batch size
MAIIA_AI_MAX_BATCH_SIZE=32

# Batch timeout in milliseconds
MAIIA_AI_BATCH_TIMEOUT_MS=100

# Directory for caching downloaded files
MAIIA_AI_CACHE_DIR=/tmp/inference-cache

# Enable caching
MAIIA_AI_ENABLE_CACHE=true

# ============================================================================
# Logging
# ============================================================================
# Rust log level: error, warn, info, debug, trace
RUST_LOG=info
